# Copy to .env and fill in. Never commit .env.

# Airtable personal access token (scopes: data.records:read, data.records:write)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# Airtable column names, if yours differ from the defaults
# AIRTABLE_FIELD_ADDRESS=Property Address
# AIRTABLE_FIELD_CITY=City
# AIRTABLE_FIELD_STATE=State
# AIRTABLE_FIELD_ZIP=Zip
# AIRTABLE_FIELD_OWNER_NAME=Owner Name
# AIRTABLE_FIELD_ARV=ARV
# AIRTABLE_FIELD_REHAB=Rehab Est
# AIRTABLE_FIELD_ASKING=Asking Price
# AIRTABLE_FIELD_MAO=MAO
# Optional single-line-text column to store offer / negotiate / pass
# AIRTABLE_FIELD_VERDICT=Deal Verdict

# Deal formula: MAO = ARV x MAO_PERCENT - rehab
MAO_PERCENT=0.65

# Offer letter signature
BUYER_NAME=
BUYER_PHONE=
BUYER_EMAIL=
OFFER_VALID_DAYS=7
